  "grammar": [
    {
      "id": "g3_1",
      "title": "Pronomes Demonstrativos: 이 / 그 / 저",
      "explanation": "Essas palavras são usadas para apontar algo.\n\n- **이**: perto de quem fala (este, esta).\n- **그**: perto de quem ouve (esse, essa).\n- **저**: longe de ambos (aquele, aquela).",
      "examples": [
        {"kr": "이 책", "pt": "Este livro (perto de mim)"},
        {"kr": "저 가방", "pt": "Aquela bolsa (longe de nós)"}
      ],
      "lusophone_tip": "Assim como no português temos este/esse/aquele, o coreano tem 이/그/저. Eles sempre acompanham um substantivo."
    },
    {
      "id": "g3_2",
      "title": "Localização: 에 있다 / 없다",
      "explanation": "A partícula **에** indica o local onde algo está existindo.\nOs verbos **있다** (ter/estar) e **없다** (não ter/não estar) indicam existência.\n\nEstrutura: [Local] + **에** + **있어요/없어요**.",
      "examples": [
        {"kr": "가방이 책상 위에 있어요.", "pt": "A bolsa está em cima da mesa."},
        {"kr": "펜이 가방 안에 없어요.", "pt": "A caneta não está dentro da bolsa."}
      ],
      "lusophone_tip": "No coreano, você primeiro diz o local e a posição (ex: mesa cima) e depois adiciona '에 있어요'. A ordem é o inverso do português!"
    }
  ],
  "cultural_notes": [
    {
      "title": "A importância da organização",
      "content": "Na Coreia, espaços organizados são muito valorizados, por isso é comum aprender posições de objetos logo no início do aprendizado.",
      "icon": "📚"
    }
  ],
