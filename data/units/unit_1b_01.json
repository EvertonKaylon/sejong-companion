  "grammar": [
    {
      "id": "g1b_01_museun",
      "title": "Pronome Interrogativo: 무슨 (Qual / Que tipo de...)",
      "explanation": "O pronome '무슨' é colocado imediatamente antes de um substantivo para perguntar sobre a espécie, gênero ou tipo de algo:\n\n**무슨 + Substantivo**\n\n* Exemplo: 무슨 음식 (Que tipo de comida?), 무슨 영화 (Qual filme?).\n* Diferença: '어느' escolhe entre opções limitadas conhecidas, enquanto '무슨' pergunta de forma aberta sobre a natureza do objeto.",
      "examples": [
        {
          "kr": "무슨 음식을 좋아해요?",
          "pt": "Qual tipo de comida você gosta?"
        },
        {
          "kr": "무슨 운동을 해요?",
          "pt": "Que esporte você pratica?"
        }
      ],
      "lusophone_tip": "Em português usamos 'qual' ou 'que tipo de'. Em coreano, '무슨' antecede o substantivo diretamente sem preposição intermediária."
    },
    {
      "id": "g1b_01_mot",
      "title": "Negação de Impossibilidade: 못 + Verbo",
      "explanation": "A partícula '못' é colocada antes do verbo para expressar incapacidade física, falta de habilidade ou impedimento circunstancial ('não conseguir fazer / não poder'):\n\n**못 + Verbo de Ação**\n\n* '안' expressa vontade própria ('não quero / não faço').\n* '못' expressa impossibilidade ('não consigo / não posso por forças externas').",
      "examples": [
        {
          "kr": "매운 음식을 못 먹어요.",
          "pt": "Não consigo comer comida apimentada."
        },
        {
          "kr": "오늘 약속에 못 가요.",
          "pt": "Não posso ir ao compromisso hoje."
        }
      ],
      "lusophone_tip": "Cuidado com a pronúncia: antes de vogal ou consoante, 못 sofre neutralização para [몯] e quando seguido de '먹' sofre nasalização [몬먹어요]."
    }
  ],
  "cultural_notes": [
