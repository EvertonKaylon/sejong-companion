  "grammar": [
    {
      "id": "g4_1",
      "title": "Terminação Polida Presente: -아요/어요",
      "explanation": "No coreano, os verbos mudam de acordo com o nível de formalidade e a vogal da raiz.\n\n- Usa-se **-아요** quando a raiz do verbo tem a vogal **ㅏ** ou **ㅗ** (ex: 가다 -> 가요, 보다 -> 봐요).\n- Usa-se **-어요** para outras vogais (ex: 먹다 -> 먹어요).\n- Verbos com **하다** tornam-se **해요**.",
      "examples": [
        {
          "kr": "먹다 -> 먹어요",
          "pt": "Como"
        },
        {
          "kr": "공부하다 -> 공부해요",
          "pt": "Estudo"
        }
      ],
      "lusophone_tip": "A raiz do verbo é encontrada removendo o '다' do final no dicionário. Essa terminação serve tanto para afirmar quanto para perguntar (mudando a entonação)."
    },
    {
      "id": "g4_2",
      "title": "Partícula de Objeto: 을 / 를",
      "explanation": "A partícula **을/를** é anexada ao substantivo para indicar que ele é o objeto direto da ação.\n\n- **을**: quando o substantivo termina em consoante (받침).\n- **를**: quando o substantivo termina em vogal.",
      "examples": [
        {
          "kr": "밥을 먹어요.",
          "pt": "Como a refeição. (밥 tem 받침)"
        },
        {
          "kr": "우유를 마셔요.",
          "pt": "Bebo leite. (우유 não tem 받침)"
        }
      ],
      "lusophone_tip": "Lembre-se que em coreano o objeto vem antes do verbo! A estrutura clássica é: Sujeito + Objeto + Verbo (SOV)."
    }
  ],
  "cultural_notes": [
    {
      "title": "A palavra 밥",
      "content": "A palavra '밥' (arroz) é frequentemente usada como sinônimo para 'refeição'. Perguntar '밥 먹었어요?' (Comeu arroz?) é uma forma comum de dizer 'Como você está?' ou 'Já comeu?'.",
      "icon": "🍚"
    }
  ],
