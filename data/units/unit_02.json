  "grammar": [
    {
      "id": "g2_1",
      "title": "Partícula de Sujeito: 이 / 가",
      "explanation": "A partícula **이/가** é adicionada ao substantivo para indicar que ele é o sujeito da frase.\n\n- Usa-se **이** quando o substantivo termina em consoante (받침).\n- Usa-se **가** quando o substantivo termina em vogal.",
      "examples": [
        {
          "kr": "선생님이",
          "pt": "O professor (sujeito)"
        },
        {
          "kr": "의사가",
          "pt": "O médico (sujeito)"
        }
      ],
      "lusophone_tip": "No português, identificamos o sujeito pela ordem das palavras. No coreano, são as partículas que cumprem esse papel. Memorizar se a palavra termina com ou sem 받침 é essencial!"
    },
    {
      "id": "g2_2",
      "title": "Negação com o verbo ser: 이/가 아니에요",
      "explanation": "A estrutura **이/가 아니에요** é usada para dizer 'não ser' algo.\n\nComo no caso da partícula de sujeito, escolhe-se **이** ou **가** com base na presença de 받침 no substantivo anterior, e depois adiciona-se **아니에요**.",
      "examples": [
        {
          "kr": "저는 학생이 아니에요.",
          "pt": "Eu não sou estudante."
        },
        {
          "kr": "투안은 의사가 아니에요.",
          "pt": "Tuan não é médico."
        }
      ],
      "lusophone_tip": "Diferente do português, onde basta adicionar 'não' antes do verbo (ex: não sou), no coreano, o substantivo negado deve receber a partícula de sujeito (이/가) antes de '아니에요'."
    }
  ],
  "cultural_notes": [
    {
      "title": "Nacionalidades em coreano",
      "content": "Em coreano, para falar sua nacionalidade, basta adicionar a palavra '사람' (pessoa) ao nome do país. Ex: 브라질 (Brasil) + 사람 (pessoa) = 브라질 사람 (brasileiro).",
      "icon": "🌎"
    }
  ],
