# Configuração do Caddy para o Saebom Companion (새봄 컴패니언)
# HTTP (:80) redireciona permanentemente para HTTPS sem emitir HSTS em texto plano (RFC 6797 §7.2)
:80 {
    redir https://saebomcompanion.duckdns.org{uri} permanent
}

# Domínio oficial DuckDNS servido exclusivamente via HTTPS (Let's Encrypt automático)
saebomcompanion.duckdns.org {
    # Proxy reverso para o container da aplicação com suporte a WebSockets Flet
    reverse_proxy app:8554 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    # Compressão de assets em tempo real
    encode zstd gzip

    # Cabeçalhos de Segurança Defensiva (OWASP A05:2021 / MITRE ATT&CK T1189 & T1190)
    header {
        # Prevenção de MIME Sniffing
        X-Content-Type-Options "nosniff"

        # Prevenção de Clickjacking
        X-Frame-Options "DENY"

        # Prevenção de vazamento de URLs internas
        Referrer-Policy "strict-origin-when-cross-origin"

        # Restrição de APIs de hardware e sensores
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

        # Forçar HTTPS com HSTS apenas em TLS (1 ano + subdomínios)
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

        # Política de Segurança de Conteúdo (CSP) compatível com Flet Web CanvasKit/Skwasm, mídia e WebSockets
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval' https://www.gstatic.com https://unpkg.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https: blob:; media-src 'self' data: blob:; worker-src 'self' blob:; connect-src 'self' ws: wss: https://www.gstatic.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self';"

        # Ofuscação de assinatura de servidor web
        -Server
    }
}
