# Configuração do Caddy para o Sejong Companion
# Se você tiver um domínio próprio (ex: sejong.seusite.com), substitua ":80" pelo domínio para ter SSL automático (HTTPS).
:80 {
    # Proxy reverso para o container do Sejong Companion com suporte total a WebSockets Flet
    reverse_proxy app:8554 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    # Compressão de assets em tempo real
    encode zstd gzip
}
