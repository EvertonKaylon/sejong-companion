# Configuração do Caddy para o Sejong Companion
# Suporta tanto o domínio DuckDNS oficial quanto acesso direto por IP na porta 80
sejongcompanion.duckdns.org, :80 {
    # Proxy reverso para o container do Sejong Companion com suporte total a WebSockets Flet
    reverse_proxy app:8554 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    # Compressão de assets em tempo real
    encode zstd gzip
}
